{
  "name": "omp",
  "description": "OneDrive Media Player",
  "private": true,
  "version": "1.9.4",
  "type": "module",
  "scripts": {
    "build": "npm run generate && webpack --mode=production --node-env=production",
    "build:dev": "npm run generate:dev && webpack --mode=production --node-env=production",
    "build:android": "cd android && gradlew assembleRelease",
    "dev": "npm run generate:dev && webpack serve",
    "tauri": "tauri",
    "lint": "npm run generate && eslint src --report-unused-disable-directives --max-warnings 0",
    "lint:dev": "npm run generate:dev && eslint src --report-unused-disable-directives --max-warnings 0",
    "lingui": "lingui extract && lingui compile --typescript",
    "generate": "node generate-version-info.mjs && npm run lingui",
    "generate:dev": "node generate-version-info.mjs --dev && npm run lingui"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.30.0",
    "@azure/msal-react": "^2.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.6",
    "@lingui/react": "^5.4.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@react-spring/web": "^9.7.5",
    "@tauri-apps/api": "^2.8.0",
    "@use-gesture/react": "^10.3.1",
    "buffer": "^6.0.3",
    "color": "^5.0.0",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "extract-colors": "^4.2.1",
    "franc-min": "^6.2.0",
    "idb-keyval": "^6.2.1",
    "music-metadata": "^11.8.3",
    "pinyin-pro": "^3.27.0",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.8.2",
    "react-virtualized": "^9.22.6",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "short-uuid": "^5.2.0",
    "swr": "^2.3.6",
    "wanakana": "^5.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.34.0",
    "@lingui/cli": "^5.4.1",
    "@lingui/swc-plugin": "^5.6.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.1",
    "@swc/core": "^1.13.5",
    "@tauri-apps/cli": "^2.8.4",
    "@types/color": "^4.2.0",
    "@types/extract-colors": "^1.1.4",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-virtualized": "^9.22.2",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "autoprefixer": "^10.4.21",
    "compression-webpack-plugin": "^11.1.0",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "dotenv-webpack": "^8.1.0",
    "eslint": "^9.34.0",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "html-webpack-plugin": "^5.6.4",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "react-refresh": "^0.17.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.6",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^6.0.1",
    "workbox-webpack-plugin": "^7.3.0"
  }
}